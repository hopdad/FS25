{
  "name": "@farmlink/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Reads FarmLink's files from modSettings and serves them; P0 prints the live vehicle channel",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "doctor": "tsx src/main.ts --doctor",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "build:win": "bun build src/main.ts --compile --target=bun-windows-x64 --outfile bin/farmlink-bridge.exe",
    "build:mac": "bun build src/main.ts --compile --target=bun-darwin-arm64 --outfile bin/farmlink-bridge-macos",
    "build:linux": "bun build src/main.ts --compile --target=bun-linux-x64 --outfile bin/farmlink-bridge-linux"
  },
  "dependencies": {
    "@farmlink/schema": "workspace:*",
    "uqr": "^0.1.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2"
  }
}
