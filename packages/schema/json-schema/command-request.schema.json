{
  "title": "command-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ping"
        },
        "farmId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "args": {
          "default": {},
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "farmId",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "worker.stop"
        },
        "farmId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "args": {
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "jobId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "farmId",
        "args"
      ],
      "additionalProperties": false
    }
  ]
}
