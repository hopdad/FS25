{
  "title": "live-fleet",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "saveId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "realTs": {
      "type": "string",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d))|(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)$"
    },
    "day": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439
    },
    "fleet": {
      "type": "object",
      "properties": {
        "vehicles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "vehicleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "name": {
                "type": "string"
              },
              "farmId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "heading": {
                    "type": "number",
                    "minimum": 0,
                    "exclusiveMaximum": 360
                  }
                },
                "required": [
                  "x",
                  "z"
                ],
                "additionalProperties": false
              },
              "fuelPct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "damagePct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "controller": {
                "type": "string",
                "enum": [
                  "player",
                  "ai",
                  "courseplay",
                  "autodrive",
                  "idle"
                ]
              }
            },
            "required": [
              "vehicleId",
              "name",
              "farmId",
              "position",
              "fuelPct",
              "damagePct",
              "controller"
            ],
            "additionalProperties": false
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "jobId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "vehicleId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "jobType": {
                "type": "string",
                "minLength": 1
              },
              "fieldId": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "progressPct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tankFillPct": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "jobId",
              "vehicleId",
              "jobType",
              "fieldId",
              "progressPct",
              "tankFillPct"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "vehicles",
        "jobs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "saveId",
    "realTs",
    "day",
    "minute",
    "fleet"
  ],
  "additionalProperties": false
}
