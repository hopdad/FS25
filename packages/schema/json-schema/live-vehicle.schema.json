{
  "title": "live-vehicle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "saveId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "sessionId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "realTs": {
      "type": "string",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d))|(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?)$"
    },
    "day": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minute": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1439
    },
    "vehicle": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "vehicleId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                {
                  "type": "null"
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "speedKmh": {
              "type": "number",
              "minimum": 0
            },
            "rpm": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "gear": {
              "type": [
                "string",
                "null"
              ]
            },
            "fuelType": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "fuelPct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "damagePct": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "operatingHours": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "position": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "heading": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                }
              },
              "required": [
                "x",
                "z"
              ],
              "additionalProperties": false
            },
            "isAI": {
              "type": "boolean"
            },
            "fillUnits": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fillType": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "level": {
                    "type": "number",
                    "minimum": 0
                  },
                  "capacity": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "fillType",
                  "level",
                  "capacity"
                ],
                "additionalProperties": false
              }
            },
            "implements": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "vehicleId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "name": {
                    "type": "string"
                  },
                  "fillUnits": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "fillType": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 64
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "level": {
                          "type": "number",
                          "minimum": 0
                        },
                        "capacity": {
                          "anyOf": [
                            {
                              "type": "number",
                              "minimum": 0
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "fillType",
                        "level",
                        "capacity"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "vehicleId",
                  "name",
                  "fillUnits"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "vehicleId",
            "name",
            "speedKmh",
            "rpm",
            "gear",
            "fuelType",
            "fuelPct",
            "damagePct",
            "operatingHours",
            "position",
            "isAI",
            "fillUnits",
            "implements"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "v",
    "saveId",
    "sessionId",
    "realTs",
    "day",
    "minute",
    "vehicle"
  ],
  "additionalProperties": false
}
